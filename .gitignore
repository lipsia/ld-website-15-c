# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
.vite/

# Environment files
.env
# .env.local needs its own line: the glob below cannot match it, because `*`
# would have to stand for the empty string between two dots.
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
# Shared editor config: Biome as formatter + the repo colour scheme.
!.vscode/settings.json

# Test & coverage
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Caches
.cache/
.temp/

# husky's generated helper scripts (regenerated by `pnpm prepare`)
.husky/_/

# Local Claude Code settings (per-machine, not shared)
.claude/settings.local.json

# generated i18n output (built by the Paraglide vite plugin / prepare hook)
src/paraglide

# TanStack Router plugin scratch dir
.tanstack

# wrangler's local state + cache, written by any `wrangler pages ...` run
.wrangler/

# Cloudflare's local-secrets convention. Nothing here is needed to build the
# site — the deploy reads its credentials from GitHub Actions secrets — so a
# .dev.vars appearing at all means someone put a real token on disk.
.dev.vars
.dev.vars.*
